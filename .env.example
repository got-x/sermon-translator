# Host ports published by Docker Compose
SESSION_HOST=localhost
SESSION_PORT=8080
TRANSLATE_PORT=5000
WHISPER_PORT=9080

# Container image versions
SESSION_IMAGE=python:3.11
TRANSLATE_IMAGE=libretranslate/libretranslate:v1.6.5
WHISPER_IMAGE=lintoai/linto-stt-whisper:2.0.0

# Whisper model: tiny, base, small, medium, or large
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# LibreTranslate language models to load (comma-separated language codes)
TRANSLATE_LANGUAGES=en,de,uk

# Audio sent to Whisper
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_DURATION_MS=100

# Internal Docker service URLs and request timeouts
TRANSLATE_BASE_URL=http://translate:5000
WHISPER_WS_URL=ws://whisper:80/ws
SERVICE_REQUEST_TIMEOUT=10
WHISPER_CONNECT_TIMEOUT=10
